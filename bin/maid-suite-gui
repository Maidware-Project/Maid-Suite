#!/usr/bin/env bash
# Maid Suite GUI entry (PyQt6). Falls back with a clear message.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"

find_gui_pkg() {
  local c
  for c in \
    "$HERE/../gui" \
    "$HERE/../share/maid-suite/gui" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/maid-suite/gui" \
    "$HOME/.local/share/maid-suite/gui"; do
    [ -d "$c/maid_suite_gui" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

has_display() { [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; }
has_pyqt() { python3 -c "import PyQt6" 2>/dev/null; }

PKG="$(find_gui_pkg || true)"
if [ -n "$PKG" ] && has_pyqt && has_display; then
  PYTHONPATH="$PKG${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m maid_suite_gui "$@"
fi

if [ -z "$PKG" ]; then
  echo "Maid Suite GUI: files missing (looked in ../gui and ~/.local/share/maid-suite/gui). Reinstall Maid Suite." >&2
elif ! has_pyqt; then
  echo "Maid Suite GUI needs PyQt6 (python3-pyqt6). Falling back: run 'maid-suite' (TUI)." >&2
  exec "$HERE/maid-suite" "$@" 2>/dev/null || exec maid-suite "$@"
else
  echo "Maid Suite GUI needs a display (Wayland/X11). Use: maid-suite" >&2
fi
exit 2
